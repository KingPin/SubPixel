{
  "name": "subpixel",
  "version": "0.0.0",
  "description": "Image generation and editing for AI coding agents, powered by your existing ChatGPT/Codex subscription.",
  "license": "Apache-2.0",
  "author": "KingPin <28669+KingPin@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingPin/SubPixel.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "spx": "dist/cli/bin.js",
    "subpixel": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli/bin.js",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:live": "SUBPIXEL_LIVE=1 vitest run tests/live",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "image-generation",
    "ai",
    "agent",
    "mcp",
    "model-context-protocol",
    "cli",
    "chatgpt",
    "codex",
    "openai",
    "gpt-image",
    "claude-code",
    "favicon",
    "assets"
  ]
}
